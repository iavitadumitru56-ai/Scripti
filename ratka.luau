function SISTEM_uvidomleniya(title, content, duration, iconId)
    local notification = {
        Title = title,
        Text = content,
        Duration = duration,
        Icon = iconId and
            "rbxthumb://type=Asset&id=" .. tostring(iconId) .. "&w=150&h=150"
            or nil
    }
    game:GetService("StarterGui"):SetCore("SendNotification", notification)
end

