		local timeDict = os.date("*t")
		clockLabel.Text = string.format("%02d:%02d", timeDict.hour, timeDict.min)
	end
end)


-- === 4. ФУНКЦИОНАЛ КНОПОК ===

-- [Кнопка 1] - "Live", игра в кошки-мышки с мышкой
local isEvading = false
local evasionStart = 0
local evasionCooldown = false

RunService.RenderStepped:Connect(function(dt)
	if not bgImage.Visible then return end

	local mouseLocation = UserInputService:GetMouseLocation()
	local btnPos = button1.AbsolutePosition + (button1.AbsoluteSize / 2)
	local distance = (mouseLocation - btnPos).Magnitude

	-- Если мышка подводится ближе 130 пикселей
	if distance < 130 then
		if not isEvading and not evasionCooldown then
			isEvading = true
			evasionStart = tick()
		end

		if isEvading then
			local timeEvading = tick() - evasionStart
			if timeEvading > 5 then
				-- Если человек пытается уже больше 5 секунд, кнопка сдается
				isEvading = false
				evasionCooldown = true
			else
				-- Кнопка слабо уходит в противоположную от мышки сторону
				local dir = (btnPos - mouseLocation).Unit
				if dir.X ~= dir.X then dir = Vector2.new(1, 0) end -- Проверка на NaN
				
				local pushDistance = 45 -- Сила, с которой она "убегает"
				local targetPos = btn1BasePos + UDim2.new(0, dir.X * pushDistance, 0, dir.Y * pushDistance)
				
				-- Плавное движение
				button1.Position = button1.Position:Lerp(targetPos, 8 * dt)
			end
		end
		
		if evasionCooldown then
			-- Кнопка успокоилась и возвращается на место
			button1.Position = button1.Position:Lerp(btn1BasePos, 10 * dt)
		end
	else
		-- Мышку убрали — сбрасываем всё, кнопка снова будет убегать в следующий раз
		if isEvading or evasionCooldown then
			isEvading = false
			evasionCooldown = false
		end
		-- Плавный возврат на место
		button1.Position = button1.Position:Lerp(btn1BasePos, 10 * dt)
	end
end)

button1.MouseButton1Click:Connect(function()
