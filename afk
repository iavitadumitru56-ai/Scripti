-- === 2. ЛОГИКА ТАЙМЕРА АФК ===
local AFK_TIME_LIMIT = 120 -- Для теста стоит 10 секунд (потом поменяй на 120 для 2 минут)
local lastInputTime = tick()
local isAfk = false

-- Обновляем таймер при любом движении или нажатии
local function resetAfkTimer()
	lastInputTime = tick()
end
UserInputService.InputBegan:Connect(resetAfkTimer)
UserInputService.InputChanged:Connect(resetAfkTimer)

-- Проверка АФК каждый кадр
RunService.Heartbeat:Connect(function()
	if not isAfk and (tick() - lastInputTime >= AFK_TIME_LIMIT) then
		isAfk = true
		bgImage.Visible = true
		bgMusic:Play()
	end
end)


-- === 3. ЛОГИКА ЧАСОВ ===
task.spawn(function()
	while task.wait(1) do
